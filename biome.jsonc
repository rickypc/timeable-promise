{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "assist": {
    "actions": {
      "source": {
        "useSortedInterfaceMembers": "on",
        "useSortedKeys": "on",
        "useSortedProperties": "on"
      }
    }
  },
  "files": {
    "includes": ["**", "!!{coverage,dist,node_modules,supports}"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "arrowParentheses": "always",
      "delimiterSpacing": false,
      "jsxQuoteStyle": "double",
      "lineEnding": "lf",
      "lineWidth": 100,
      "operatorLinebreak": "before",
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "linter": {
    "rules": {
      "complexity": {
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": {
            "maxLines": 100,
            "skipBlankLines": true,
            "skipIifes": true
          }
        },
        "useMaxParams": {
          "level": "error",
          "options": { "max": 10 }
        }
      },
      "nursery": {
        "noConditionalExpect": "error",
        "noExcessiveNestedCallbacks": {
          "level": "error",
          "options": { "max": 5 }
        },
        "noIdenticalTestTitle": "error",
        "noImpliedEval": "error",
        "noLoopFunc": "error",
        "noReactStringRefs": "error",
        "useExpect": "error",
        "useImportsFirst": "error",
        "useThisInClassMethods": {
          "level": "error",
          "options": { "ignoreOverrideMethods": false }
        },
        "useVarsOnTop": "error"
      },
      "preset": "recommended",
      "style": {
        "noExcessiveClassesPerFile": {
          "level": "error",
          "options": { "maxClasses": 1 }
        },
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": { "maxLines": 1000, "skipBlankLines": true }
        },
        "noRestrictedGlobals": {
          "level": "error",
          "options": {
            "deniedGlobals": {
              "isFinite": "Use Number.isFinite instead https://github.com",
              "isNaN": "Use Number.isNaN instead https://github.com"
            }
          }
        }
      },
      "suspicious": {
        "noBitwiseOperators": {
          "level": "error",
          "options": { "allow": ["~"] }
        },
        "noExplicitAny": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["tests/**/*.ts"],
      "javascript": {
        "globals": ["describe", "expect", "jest", "test"]
      }
    }
  ]
}
