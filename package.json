{
  "author": {
    "email": "rickypc@users.noreply.github.co",
    "name": "Richard Huang"
  },
  "description": "Various asynchronous operations with timeout support.",
  "devDependencies": {
    "@airbnb/node-memwatch": "3.0.0",
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "10.0.1",
    "@rspack/cli": "2.0.2",
    "@rspack/core": "2.0.2",
    "@swc/core": "1.15.33",
    "@swc/jest": "0.2.39",
    "@types/airbnb__node-memwatch": "2.0.4",
    "@types/eslint-plugin-security": "3.0.1",
    "@types/jest": "30.0.0",
    "bench-node": "0.15.0",
    "eslint": "10.3.0",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "29.15.2",
    "eslint-plugin-jsdoc": "62.9.0",
    "eslint-plugin-no-secrets": "2.3.3",
    "eslint-plugin-security": "4.0.0",
    "eslint-plugin-yml": "3.3.2",
    "jest": "30.4.1",
    "jiti": "2.7.0",
    "remove-types": "1.0.0",
    "ts-checker-rspack-plugin": "1.3.0",
    "typedoc": "0.28.19",
    "typedoc-plugin-markdown": "4.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.2",
    "yaml-eslint-parser": "2.0.0"
  },
  "homepage": "https://github.com/rickypc/timeable-promise#readme",
  "imports": {
    "#root/*": "./*"
  },
  "keywords": [
    "promise utilities",
    "concurrency",
    "sequential execution",
    "async control",
    "timeout handling",
    "polling",
    "sleep",
    "task scheduling",
    "typescript",
    "utility library"
  ],
  "license": "AGPL-3.0",
  "name": "timeable-promise",
  "overrides": {
    "@typescript-eslint/utils": "*",
    "baseline-browser-mapping": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/rickypc/timeable-promise.git"
  },
  "scripts": {
    "build": "npm run build:docs && npm run build:dist",
    "build:dist": "rspack build",
    "build:docs": "typedoc",
    "deploy": "npm run deploy:ready && npm run deploy:tag && echo \"\\033[1;32mnpm publish ./dist --verbose\\033[0m\"",
    "deploy:dry": "npm run deploy:ready && npm publish --dry-run ./dist --verbose && echo \"\\033[1;32mgit commit && git push origin && npm run deploy\\033[0m\" || echo \"\\033[1;31m$(npm pkg get name | tr -d '\"') v$(npm pkg get version | tr -d '\"') is published. Do you want to bump up the version and modify CHANGELOG?\\033[0m\"",
    "deploy:ready": "npm test && npm run build",
    "deploy:tag": "git tag $(npm pkg get version | tr -d '\"') && git push --tags",
    "test": "npm run test:deps:ci && npm run test:lint && npm run test:type && npm run test:unit && npm run test:perf && npm run test:leak",
    "test:deps:ci": "npm outdated --json | jq -r 'to_entries[] | [.key, .value.current, .value.wanted, .value.latest] | @tsv' | sed 's/\t/ | /g'",
    "test:leak": "sh -c 'RESILIENT_TYPE=leak jest \"$@\"' --",
    "test:leak:ci": "CI=true npm run test:leak",
    "test:lint": "eslint .",
    "test:perf": "sh -c 'RESILIENT_TYPE=perf node --allow-natives-syntax ./node_modules/.bin/jest \"$@\"' --",
    "test:perf:ci": "CI=true npm run test:perf",
    "test:type": "tsc",
    "test:unit": "sh -c 'jest \"$@\"' --",
    "test:unit:ci": "CI=true npm run test:unit"
  },
  "type": "module",
  "version": "1.7.4"
}
